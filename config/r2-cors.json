{
  "rules": [
    {
      "allowed": {
        "origins": ["https://hinanbase.pages.dev", "https://*.hinanbase.pages.dev", "http://localhost:5173"],
        "methods": ["GET", "HEAD"],
        "headers": ["Range"]
