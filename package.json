{
  "name": "hinanbase",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "data:facilities": "tsx scripts/build-facilities.ts",
    "data:tiles": "tsx scripts/build-tiles.ts",
    "data:summaries": "tsx scripts/build-summaries.ts",
    "data:build": "npm run data:facilities && npm run data:hazards && npm run data:roads && npm run data:depth && npm run data:capacity && npm run data:rescore && npm run data:tiles && npm run data:summaries && npm run data:evacuees && npm run data:points && npm run data:geocode",
    "data:serve": "tsx scripts/serve-data.ts",
    "data:upload": "tsx scripts/upload-r2.ts",
    "data:sync": "tsx --env-file=.env.local scripts/sync-supabase.ts",
    "data:rescore": "tsx --env-file-if-exists=.env.local scripts/rescore.ts",
    "data:daily": "npm run data:rescore && npm run data:tiles && npm run data:summaries && npm run data:evacuees && npm run data:points",
    "data:hazards": "tsx scripts/fetch-hazards.ts",
    "data:roads": "tsx scripts/build-roads.ts",
    "data:capacity-check": "tsx scripts/check-capacity.ts",
    "data:capacity": "tsx scripts/import-capacity.ts",
    "data:evacuees": "tsx scripts/build-evacuees.ts",
    "data:geocode": "tsx scripts/build-geocode.ts",
    "data:points": "tsx scripts/build-points.ts",
    "data:depth": "tsx scripts/build-depth.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "maplibre-gl": "^6.17.0",
    "pmtiles": "^4.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "csv-parse": "^7.0.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  }
}
